# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Régénéré à chaque build (hook build:before dans nuxt.config.ts) — ne
# doit jamais être commité avec une valeur figée
public/version.txt

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea
.opencode
opencode.json

# Local env files
.env
.env.*
!.env.example
.wrangler
.wrangler/tmp
test-results

# Backup / debug artifacts
package.json.save

# scripts/ est ignoré par défaut (scripts ponctuels de dépannage, souvent liés
# à un incident précis et chargeant le .env), sauf l'outillage réutilisable
# ci-dessous. Écrit en `scripts/*` et non `scripts/` : git ne sait pas
# ré-inclure un fichier dont un répertoire parent est exclu.
scripts/*
!scripts/add-block.ts
!scripts/generate-tests.ts
!scripts/optimize-images.sh
!scripts/scan-secrets.sh
!scripts/generate-site-images.mjs

# Playwright MCP artifacts
.playwright-mcp/

# Debug screenshots
debug-*.png

# Wix export (legacy reference)
messages.html

# Standalone Node.js binaries
node-v*.tar.gz
reggae-songmaker/

# GSD Planning files
.planning/

# Scratch test files
tests/scratch/

# Audit artifacts
fade_audit/
audit-*.js

# BMAD Method - AI-driven development framework
# Contains agents, workflows, tasks, and generated artifacts
# These are user-specific planning documents and should not be committed
_bmad/
_bmad-output/
.dev.vars
