# Sentinelle de déploiement lue par plugins/deployment-check.client.ts :
# doit toujours refléter le build en ligne, jamais une copie en cache.
/version.txt
  cache-control: no-store

# Application installable (PWA). Le service worker doit être revalidé à
# chaque visite pour que ses mises à jour arrivent ; le manifeste et la page
# hors ligne changent rarement mais suivent le même principe.
/sw.js
  cache-control: no-cache
/manifest.webmanifest
  cache-control: no-cache
/offline.html
  cache-control: no-cache
